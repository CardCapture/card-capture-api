-- Fix RLS policy to use profiles table instead of auth.users
-- The school_id column exists in profiles, not in auth.users

-- Drop the incorrect policy
DROP POLICY IF EXISTS "Users can access events from their school" ON public.events;

-- Create the corrected policy that checks profiles table
CREATE POLICY "Users can access events from their school" ON public.events
    FOR ALL USING (school_id = (
        SELECT school_id FROM public.profiles 
        WHERE profiles.id = auth.uid()
    ));